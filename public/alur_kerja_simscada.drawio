        </mxCell>

        <mxCell id="adm_l13_settings" value="[L13] Pengaturan Lembaga &amp; SOP Lokal&#xa;• Tetapkan Ambang Kelulusan (KKM 70, Misi Kelulusan 80)&#xa;• Pilih Warna Aksen Piagam (Navy Blue)&#xa;• Aktifkan Saklar: 'Persetujuan Instruktur Wajib'&#xa;• Input Catatan SOP Lokal per Titik Kontrol (Koagulasi)&#xa;• (Catatan: Ambang Alarm Baku Terkunci di Super Admin)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#059669;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_admintenant">
          <mxGeometry x="80" y="270" width="300" height="110" as="geometry" />
        </mxCell>

        <mxCell id="adm_l12_users" value="[L12] Kelola Akun &amp; Kuota Kursi&#xa;• Pantau Kuota Kursi: 46/50 Terpakai (Sisa 4)&#xa;• Buat Akun Instruktur (Pak Budi)&#xa;• Buat Akun Peserta: baru, ipa, distribusi, lulus&#xa;• Bentuk Kelompok: Angkatan 1 &amp; Angkatan 2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#064e3b;strokeColor=#059669;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_admintenant">
          <mxGeometry x="80" y="420" width="300" height="95" as="geometry" />
