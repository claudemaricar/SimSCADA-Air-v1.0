        <!-- Node L8b: Status Menunggu Persetujuan Instruktur -->
        <mxCell id="tr_l8b_pending" value="[L8b] Status: Menunggu Persetujuan Instruktur&#xa;• Seluruh misi lulus, Post-Test 84, Menunggu Pak Budi&#xa;• Tombol Unduh PDF Nonaktif (Disabled) dengan Watermark&#xa;• Sesuai kebijakan lembaga di L13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#d97706;strokeWidth=2;fontColor=#fde68a;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_operator">
          <mxGeometry x="170" y="1390" width="340" height="85" as="geometry" />
