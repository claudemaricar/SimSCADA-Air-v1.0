        <!-- NODES: LANE 3 - INSTRUKTUR (L9, L10, L11)  -->
        <!-- ========================================== -->
        <mxCell id="ins_l1_login" value="[L1] Login Instruktur SPAM&#xa;• Akun: instruktur.nusantara (Pak Budi)&#xa;• Sandi Demo: Demo#2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_instruktur">
          <mxGeometry x="110" y="150" width="280" height="70" as="geometry" />
        </mxCell>

        <mxCell id="ins_l9_roster" value="[L9] Dasbor Pengawasan Kelas Instruktur&#xa;• Pantau Matriks Peserta × Misi (IPA-01 s/d TRP-02)&#xa;• Pantau Capaian Bintang, Skor Terakhir &amp; Hari Aktif&#xa;• Deteksi Otomatis Peserta Tertinggal (3x Gagal)&#xa;• Tombol: Tugaskan Misi, Unlock, Beri Catatan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#d97706;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_instruktur">
          <mxGeometry x="90" y="275" width="320" height="95" as="geometry" />
        </mxCell>

        <mxCell id="ins_l10_author" value="[L10] Kelola Skenario Gangguan Kustom&#xa;• Rancang Skenario Abnormalitas (FR-23)&#xa;• Pilih Tingkat Kesulitan: 1 Mudah s/d 5 Ujian&#xa;• Set Waktu Picu &amp; Kunci Penilaian SOP&#xa;• Tugaskan ke Kelompok Angkatan 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#d97706;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_instruktur">
          <mxGeometry x="90" y="420" width="320" height="95" as="geometry" />
        </mxCell>

        <mxCell id="ins_l9_unlock" value="[L9] Intervensi Buka Kunci (Unlock)&#xa;• Buka Kunci Misi Manual bagi Peserta Remedial&#xa;• Berikan bimbingan tambahan sebelum ujian" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#78350f;strokeColor=#f59e0b;strokeWidth=1.5;fontColor=#fde68a;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_instruktur">
          <mxGeometry x="90" y="1030" width="320" height="65" as="geometry" />
        </mxCell>

        <mxCell id="ins_l11_replay" value="[L11] Investigasi Audit &amp; Putar Ulang (Replay)&#xa;• Interactive Timeline Scrubber (00:00 - 08:30)&#xa;• Audit Kronologis Alarm ISA-18.2 &amp; Waktu ACK&#xa;• Sinkronisasi Kurva Kekeruhan vs Dosis Koagulan&#xa;• Tulis Catatan Pedagogis &amp; Validasi Sesi Selesai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#451a03;strokeColor=#d97706;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_instruktur">
