        <mxCell id="tr_l8_cert" value="[L8] PIAGAM KELULUSAN RESMI TERBIT&#xa;• Format Cetak A4 Landscape Bersih (Bukan Sertifikat)&#xa;• Nomor Unik: SSA/NUS/2026/0001 · Predikat: Lulus dengan Baik&#xa;• Tanda Tangan: Pimpinan (Dr. Bambang) &amp; Instruktur (Pak Budi)&#xa;• QR Code Validasi Publik L16 · Catatan Kaki Wajib PRD §13" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065f46;strokeColor=#34d399;strokeWidth=2.5;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_operator">
