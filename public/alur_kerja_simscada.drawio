        </mxCell>

        <mxCell id="ins_approve" value="[L9] Verifikasi &amp; Tanda Tangan Piagam&#xa;• Validasi Kelulusan 4 Syarat PRD §13&#xa;• Bubuhkan Tanda Tangan Digital Instruktur&#xa;• Buka Kunci Unduh Piagam di Layar Peserta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065f46;strokeColor=#34d399;strokeWidth=2.5;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_instruktur">
          <mxGeometry x="90" y="1410" width="320" height="85" as="geometry" />
        </mxCell>

