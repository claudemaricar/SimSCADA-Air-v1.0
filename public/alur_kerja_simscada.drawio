        <mxCell id="tr_l4a_post" value="[L4a] Post-Test Evaluasi Akhir Jalur&#xa;• Diambil setelah menyelesaikan Misi Kelulusan&#xa;• Syarat Kelulusan PRD §13: Nilai Post-Test Wajib ≥ 70&#xa;• Capaian Dimas: Skor 84/100 (Kenaikan Metrik T1: +50%)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#082f49;strokeColor=#0284c7;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_operator">
          <mxGeometry x="170" y="1280" width="340" height="80" as="geometry" />
