        <mxCell id="sa_start" value="Mulai Operasi Platform" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4338ca;strokeColor=#818cf8;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="lane_superadmin">
