        <mxCell id="adm_l1_login" value="[L1] Login Multi-Tenant Admin&#xa;• Akun: admin.nusantara (Sandi: Demo#2026)&#xa;• Sistem otomatis mengenali peran &amp; tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#065f46;strokeColor=#34d399;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_admintenant">
