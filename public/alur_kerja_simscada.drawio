        <!-- NODES: LANE 4 - OPERATOR TRAINEE (L2 - L8) -->
        <!-- ========================================== -->
        <mxCell id="tr_l1_login" value="[L1] Login Peserta Operator&#xa;• Akun: peserta.baru / peserta.ipa (Dimas)&#xa;• Sandi Demo: Demo#2026" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0369a1;strokeColor=#38bdf8;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_operator">
