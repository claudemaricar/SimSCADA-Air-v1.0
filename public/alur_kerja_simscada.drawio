        </mxCell>

        <mxCell id="sa_l15_prov" value="[L15] Registrasi Lembaga Tenant&#xa;• Balai Diklat Air Minum Nusantara (NUS)&#xa;• Pusat Pelatihan Tirta Mandiri (TRM)&#xa;• Inisialisasi Isolasi Database Multi-Tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_superadmin">
          <mxGeometry x="60" y="150" width="280" height="85" as="geometry" />
        </mxCell>

        <mxCell id="sa_l15_license" value="[L15] Alokasi Paket Lisensi &amp; Kuota Kursi&#xa;• Alokasi 50 Kursi Nusantara &amp; 50 Kursi Tirta&#xa;• Paket Jalur: Terpadu (17 Misi) / IPA (9 Misi)&#xa;• Tetapkan Ambang Alarm Baku Terpusat (Permenkes)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=2;fontColor=#ffffff;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_superadmin">
          <mxGeometry x="60" y="275" width="280" height="85" as="geometry" />
        </mxCell>

        <mxCell id="sa_l15_monitor" value="[L15] Monitoring Global &amp; Peringatan Dini&#xa;• ⚠️ Peringatan Kuota ≥90% (Nusantara 46/50 kursi)&#xa;• ⚠️ Peringatan Lisensi ≤30 Hari (Tirta 28 hari)&#xa;• Pantau Latensi Server Simulasi 1 Hz Global" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#312e81;strokeColor=#6366f1;strokeWidth=1.5;fontColor=#c7d2fe;fontSize=11;align=left;spacingLeft=12;" vertex="1" parent="lane_superadmin">
          <mxGeometry x="60" y="1500" width="280" height="95" as="geometry" />
        </mxCell>

